/* Berin - userland linker script */

ENTRY(_start)

SECTIONS
{
    . = 0x400000;      /* user code starts at 4 MB */

    .text : ALIGN(4K)
    {
        *(.text)
    }

    .rodata : ALIGN(4K)
    {
        *(.rodata)
    }

    .data : ALIGN(4K)
    {
        *(.data)
    }

    .bss : ALIGN(4K)
    {
        *(COMMON)
        *(.bss)
    }
}
